<!-- Two users only, both scoped to the database `interview`:
     loader   — the admin app: tables in `interview` + reading files from user_files (the uploads mount) via file();
                no url()/remote()/s3()/mysql()/... and no other databases;
     metabase — read-only SELECT/SHOW on `interview`. -->
<clickhouse>
    <profiles>
        <loader>
            <max_memory_usage>1000000000</max_memory_usage>
            <max_threads>2</max_threads>
            <max_insert_threads>2</max_insert_threads>
            <log_queries>0</log_queries>
        </loader>
        <analyst>
            <readonly>2</readonly>
            <max_memory_usage>800000000</max_memory_usage>
            <max_threads>2</max_threads>
            <max_execution_time>120</max_execution_time>
            <!-- 26.x answers compress=1 with ZSTD; the Metabase JDBC driver only reads LZ4. -->
            <network_compression_method>LZ4</network_compression_method>
            <log_queries>1</log_queries>
            <log_queries_min_type>QUERY_FINISH</log_queries_min_type>
        </analyst>
    </profiles>

    <users>
        <default remove="1"/>
        <loader>
            <password from_env="CH_LOADER_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>loader</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT, INSERT, ALTER, CREATE TABLE, DROP TABLE, TRUNCATE, SHOW, CREATE DATABASE ON interview.*</query>
                <query>GRANT CREATE TEMPORARY TABLE, FILE ON *.*</query>
                <query>GRANT SELECT ON system.query_log</query>
            </grants>
        </loader>
        <metabase>
            <password from_env="CH_METABASE_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>analyst</profile>
            <quota>default</quota>
            <grants><query>GRANT SELECT, SHOW ON interview.*</query></grants>
        </metabase>
    </users>
</clickhouse>
