[Unit]
Description=Interview stack admin (ClickHouse + Metabase on demand)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/interview/admin
EnvironmentFile=/opt/interview/state/admin.env
ExecStart=/opt/interview/admin/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 18090 --workers 1 --no-access-log --log-level warning --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUQuota=50%
LogLevelMax=warning
UMask=0077

[Install]
WantedBy=multi-user.target
